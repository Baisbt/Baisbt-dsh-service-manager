{
  "name": "dsh-service-manager",
  "version": "0.13.2",
  "description": "MCP 服务器与 SKILL 的统一管理页：查看、安装、启停、删除 MCP，浏览技能并用本地模型翻译摘要。",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "Baisbt",
  "homepage": "https://github.com/Baisbt/Baisbt-dsh-service-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Baisbt/Baisbt-dsh-service-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Baisbt/Baisbt-dsh-service-manager/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "mcp-server",
    "skill",
    "skills",
    "model-context-protocol"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node test/render-smoke.mjs && node test/host-smoke.mjs",
    "stamp": "node scripts/stamp.mjs",
    "stamp:check": "node scripts/stamp.mjs --check"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.tsx",
    "tsconfig.json",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.9.3"
  }
}
